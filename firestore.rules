rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each user's notes/folders live in a top-level collection named
    // after their own uid (see lib/resources/firestore_methods.dart and
    // lib/resources/firstore_folder_methods.dart).
    match /{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
